{
  "name": "@youtube-media/mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for managing YouTube videos, playlists, thumbnails, and analytics.",
  "type": "module",
  "scripts": {
    "mcp": "bun run src/mcp.ts",
    "auth": "bun run src/auth-server.ts",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:local": "wrangler deploy --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint apps/mcp --type-aware --deny-warnings"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "elysia": "^1.4.30",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4"
  }
}
