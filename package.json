{
  "name": "youtube-mcp",
  "version": "1.0.0",
  "description": "MCP server for managing YouTube videos, playlists, thumbnails and analytics. Runs on Bun or Cloudflare Workers.",
  "license": "MIT",
  "author": "Sankalpa Acharya",
  "repository": {
    "type": "git",
    "url": "https://github.com/sankalpaacharya/youtube-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "youtube",
    "youtube-api",
    "claude",
    "ai",
    "bun",
    "elysia",
    "cloudflare-workers"
  ],
  "type": "module",
  "scripts": {
    "mcp": "bun run src/mcp.ts",
    "auth": "bun run src/auth-server.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "elysia": "^1.4.30",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
