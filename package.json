{
  "name": "youtube-media",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo for the YouTube MCP server and the media creation workspace.",
  "license": "MIT",
  "author": "Sankalpa Acharya",
  "repository": {
    "type": "git",
    "url": "https://github.com/sankalpaacharya/youtube-mcp.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @youtube-media/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint . --type-aware --deny-warnings",
    "lint:fix": "oxlint . --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "mcp": "pnpm --filter @youtube-media/mcp mcp",
    "auth": "pnpm --filter @youtube-media/mcp auth",
    "deploy": "pnpm --filter @youtube-media/mcp deploy"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
