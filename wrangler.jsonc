{
  "name": "youtube-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Provisioned automatically by the Deploy to Cloudflare button.
  // For manual deploys: `wrangler kv namespace create TOKENS` and paste the id.
  "kv_namespaces": [{ "binding": "TOKENS", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],
  "vars": {
    // Your Google OAuth client id (see README, step 1)
    "GOOGLE_CLIENT_ID": "your-client-id.apps.googleusercontent.com"
  }
  // Secrets (set during the deploy flow, or via `wrangler secret put`):
  //   GOOGLE_CLIENT_SECRET - from the same OAuth client
  //   MCP_PATH_TOKEN       - random URL secret, e.g. `openssl rand -hex 24`
}
